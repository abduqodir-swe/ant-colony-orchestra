# Copy to server/.env and fill in what you use. Never commit the real .env.

# --- Models -------------------------------------------------------------------
# Every agent runs on ANT_MODEL_DEFAULT unless it has its own ANT_MODEL_<AGENT_ID>.
# Values are Mastra model-router strings: "<provider>/<model>".
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANT_MODEL_DEFAULT=anthropic/claude-opus-5-5
# ANT_MODEL_BACKEND_01=openai/gpt-5.6-sol
# ANT_MODEL_DESIGNER_01=google/gemini-3.5-flash
# Reasoning effort for Claude models (low | medium | high | xhigh | max)
# ANT_EFFORT=high

# --- Mode ---------------------------------------------------------------------
# auto (default): live when every agent's provider has a key, otherwise mock.
# mock: scripted model, no API calls, no cost - for demos and UI work.
# ANT_MODE=auto

# --- Server -------------------------------------------------------------------
# Only localhost by default: agents write files and run commands on this machine.
# ANT_HOST=127.0.0.1
# ANT_PORT=8787
# Where agents work (default: server/workspace) and where logs live (default: server/data)
# ANT_WORKSPACE=
# ANT_DATA_DIR=
# Let sandboxed commands reach the network (npm install etc.). Off by default.
# ANT_SANDBOX_NETWORK=0

# Mastra sends anonymous usage telemetry unless this is set; the server sets it to 1 by default.
# MASTRA_TELEMETRY_DISABLED=1
